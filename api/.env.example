ENVIRONMENT=development
# A hosted database's connection string (Neon's, for one) also works as given:
# postgresql:// and sslmode are translated for asyncpg.
SQLALCHEMY_DATABASE_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/planstride
SQLALCHEMY_ECHO=False
LOG_LEVEL=DEBUG
SECRET_KEY=replace_me
SECURE_COOKIE=False
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# Stays on the server. Leave empty to run without AI: planning still works and
# the AI buttons explain that AI isn't configured.
GOOGLE_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
